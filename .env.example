DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
GEMINI_API_KEY="your-gemini-api-key"
# Optional — only needed if learners choose "OpenRouter" as their model host
# in the sidebar's Model settings. Without it, that provider's model list
# simply comes back empty and Gemini stays fully usable on its own.
OPENROUTER_API_KEY="your-openrouter-api-key"
